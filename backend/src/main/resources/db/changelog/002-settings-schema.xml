<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <changeSet id="002" author="dailier">

        <createTable tableName="settings">
            <column name="id" type="INTEGER" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="send_time" type="VARCHAR(5)"/>
            <column name="email_address" type="VARCHAR(255)"/>
            <column name="notification_time" type="VARCHAR(5)"/>
            <column name="daily_hour" type="VARCHAR(5)"/>
        </createTable>

        <sql>
            INSERT INTO settings (id, send_time, email_address, notification_time, daily_hour)
            VALUES (
                1,
                (SELECT send_time FROM email_config ORDER BY id LIMIT 1),
                (SELECT email_address FROM email_config ORDER BY id LIMIT 1),
                (SELECT notification_time FROM notification_config ORDER BY id LIMIT 1),
                NULL
            );
        </sql>

        <dropTable tableName="email_config"/>
        <dropTable tableName="notification_config"/>

    </changeSet>

</databaseChangeLog>

