<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <changeSet id="001" author="dailier">

        <createTable tableName="notification_config">
            <column name="id" type="INTEGER" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="notification_time" type="VARCHAR(5)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createTable tableName="email_config">
            <column name="id" type="INTEGER" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="send_time" type="VARCHAR(5)">
                <constraints nullable="false"/>
            </column>
            <column name="email_address" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createTable tableName="daily_entry">
            <column name="id" type="INTEGER" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="date" type="VARCHAR(10)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="did_yesterday" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="will_do_today" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="blockers" type="TEXT"/>
        </createTable>

    </changeSet>

</databaseChangeLog>

