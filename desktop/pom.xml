<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.personal</groupId>
        <artifactId>dailier-parent</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>dailier-desktop-build</artifactId>
    <packaging>pom</packaging>
    <name>dailier-desktop-build</name>
    <description>Dailier — Electron desktop packaging orchestration</description>

    <build>
        <plugins>
            <plugin>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>desktop-npm-install</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <exec executable="${npm.executable}" dir="${project.basedir}" failonerror="true">
                                    <arg value="install"/>
                                </exec>
                            </target>
                        </configuration>
                    </execution>
                    <execution>
                        <id>desktop-prepare-bundle</id>
                        <phase>package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <exec executable="${npm.executable}" dir="${project.basedir}" failonerror="true">
                                    <arg value="run"/>
                                    <arg value="prepare:bundle:skip-build"/>
                                </exec>
                            </target>
                        </configuration>
                    </execution>
                    <execution>
                        <id>desktop-verify</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <exec executable="${npm.executable}" dir="${project.basedir}" failonerror="true">
                                    <arg value="run"/>
                                    <arg value="verify"/>
                                </exec>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>desktop-dist</id>
            <build>
                <plugins>
                    <plugin>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <id>desktop-clean-dist-output</id>
                                <phase>prepare-package</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <configuration>
                                    <target>
                                        <exec executable="taskkill" osfamily="windows" failonerror="false" failifexecutionfails="false">
                                            <arg value="/IM"/>
                                            <arg value="Dailier.exe"/>
                                            <arg value="/F"/>
                                        </exec>
                                        <delete dir="${project.basedir}/dist" includeemptydirs="true" quiet="true"/>
                                    </target>
                                </configuration>
                            </execution>
                            <execution>
                                <id>desktop-package-windows-installer</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <configuration>
                                    <target>
                                        <exec executable="${npm.executable}" dir="${project.basedir}" failonerror="true">
                                            <arg value="run"/>
                                            <arg value="package:win:skip-build"/>
                                        </exec>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>

