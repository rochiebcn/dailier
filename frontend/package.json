{
  "name": "dailier-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.conf.json --port 4201",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
